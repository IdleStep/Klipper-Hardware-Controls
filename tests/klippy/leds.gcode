ASSERT_VAR MACRO=SET_PIN VARIABLE=value_daystick VALUE=-1
LED_ON
ASSERT_VAR MACRO=SET_PIN VARIABLE=value_daystick VALUE=1.0
ASSERT_VAR MACRO=SET_PIN VARIABLE=value_plainstick VALUE=1.0
ASSERT_VAR MACRO=SET_LED VARIABLE=red_discostick VALUE=1.0
LED_DIM
; plainstick has no pwm, so the dim level would be refused: it stays as it was and a warning
; is sent.
ASSERT_VAR MACRO=SET_PIN VARIABLE=value_daystick VALUE=0.33
ASSERT_VAR MACRO=SET_PIN VARIABLE=value_plainstick VALUE=1.0
ASSERT_VAR MACRO=SET_LED VARIABLE=red_discostick VALUE=0.33
ASSERT_VAR MACRO=RESPOND VARIABLE=warnings VALUE=1
LED_OFF
ASSERT_VAR MACRO=SET_PIN VARIABLE=value_daystick VALUE=0.0
ASSERT_VAR MACRO=SET_PIN VARIABLE=value_plainstick VALUE=0.0
ASSERT_VAR MACRO=SET_LED VARIABLE=red_discostick VALUE=0.0
ASSERT_VAR MACRO=RESPOND VARIABLE=warnings VALUE=1
